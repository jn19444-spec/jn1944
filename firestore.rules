rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 게시판 목록/구조는 누구나 볼 수 있고, 수정은 로그인한 관리자만 가능
    match /boards/{boardId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /posts/{postId} {
      // 비공개(private) 게시판 글은 로그인한 관리자만 읽을 수 있음
      // 그 외 게시판 글은 누구나 읽을 수 있음
      allow read: if resource.data.boardId != 'private' || request.auth != null;

      // 글쓰기/수정/삭제는 로그인한 관리자만 가능
      allow create, update, delete: if request.auth != null;
    }
  }
}
