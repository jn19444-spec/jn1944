rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 사이트에 딱 한 명 있는 진짜 관리자(주인)인지 확인
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/config/site)
        && get(/databases/$(database)/documents/config/site).data.adminUid == request.auth.uid;
    }

    // 비공개 게시판 열람 권한을 받은 회원인지 확인
    function canViewPrivate() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.canViewPrivate == true;
    }

    // 로그인한 승인된 회원인지 확인("회원공개" 등급 열람용)
    function isApprovedMember() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.approved != false;
    }

    // 게시글의 공개범위를 읽어요. visibility 필드가 없는 예전 글은 isPrivate로부터 자동 변환.
    function postVisibility(data) {
      return data.visibility != null
        ? data.visibility
        : (data.isPrivate == true ? 'private' : 'public');
    }
    function canReadPost(data) {
      return postVisibility(data) == 'public'
        || isAdmin()
        || (postVisibility(data) == 'members' && isApprovedMember())
        || (postVisibility(data) == 'private' && canViewPrivate());
    }

    // ---------- 사이트 설정(관리자가 누구인지) ----------
    // 배포 후 맨 처음 로그인하는 사람이 자동으로 관리자가 됨(딱 한 번만 생성 가능)
    match /config/site {
      allow read: if true;
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/config/site);
      allow update: if isAdmin();
    }

    // ---------- 회원 ----------
    match /members/{uid} {
      allow read: if true;
      // 가입 시 스스로는 승인 대기(false) 상태로만 만들 수 있음
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.approved == false
        && request.resource.data.canViewPrivate == false;
      // 승인 여부/비공개 열람 권한은 관리자만 바꿀 수 있음(본인이 스스로 승격 불가)
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.approved == resource.data.approved
            && request.resource.data.canViewPrivate == resource.data.canViewPrivate);
      allow delete: if isAdmin();
    }

    // ---------- 즐겨찾기(개인 북마크) ----------
    // 본인 것만 읽고 쓸 수 있음(다른 사람 즐겨찾기는 볼 수도 없음)
    match /favorites/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ---------- 게시판 목록/구조 ----------
    match /boards/{boardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- 상단 메뉴 (헤더 아래 바로가기 바) ----------
    match /topMenus/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- 게시글 ----------
    match /posts/{postId} {
      allow read: if canReadPost(resource.data);
      allow create, update, delete: if isAdmin();
    }

    // ---------- 음악 플레이어 곡 목록 ----------
    match /musicTracks/{trackId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
